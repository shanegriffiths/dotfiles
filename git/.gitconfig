[user]
	email = shane@studiobr.io
	name = Shane Griffiths
[core]
	excludesfile = ~/.gitignore_global
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	# Dark mode: pinned Catppuccin Mocha. Light mode: the "github-light"
	# feature below, activated via DELTA_FEATURES exported per-appearance
	# in zsh/.zshrc (delta does NOT auto-detect through a pager pipe).
	syntax-theme = "Catppuccin Mocha"
	navigate = true
	side-by-side = true
	line-numbers = true
	hyperlinks = true
[delta "github-light"]
	light = true
	syntax-theme = GitHub
[merge]
	conflictstyle = zdiff3
[difftool "Kaleidoscope"]
	cmd = ksdiff --partial-changeset --relative-path \"$MERGED\" -- \"$LOCAL\" \"$REMOTE\"
[mergetool "Kaleidoscope"]
	cmd = ksdiff --merge --output \"$MERGED\" --base \"$BASE\" -- \"$LOCAL\" --snapshot \"$REMOTE\" --snapshot
	trustExitCode = true
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[include]
	# Per-machine overrides (git identity etc). Last include wins, so a
	# profile like kitvoss sets its own user.name/email in ~/.gitconfig.local
	# instead of editing this stowed file (which creates permanent repo drift).
	path = ~/.gitconfig.local
